extends RigidBody2D
class_name PushBlock
## Толкаемый ящик. Игрок пихает его телом (кинематик двигает ригид), чтобы забраться
## выше или придавить кнопку. Вращение заблокировано, демпфирование гасит скольжение —
## двигается «увесисто» и предсказуемо. Слой 1: сплошной, на нём можно стоять.

func _ready() -> void:
	add_to_group("pushblock")
