extends Room
## Комната 1 «Окраина» — старт. Слева стена, справа внизу дверь → room2.
## Опциональная wall-jump-шахта ведёт к чекпоинту-награде наверху.

func build() -> void:
	size = Vector2i(40, 23)

	_fill(0, 0, 40, 1)                  # потолок
	_fill(0, 20, 40, 3)                 # пол
	_fill(0, 0, 2, 23)                  # левая стена
	_fill(38, 0, 2, 18)                 # правая стена (проём-дверь в рядах 18–19)

	_fill(5, 18, 4, 1)                  # P1
	_fill(11, 16, 4, 1)                 # P2
	_fill(17, 14, 4, 1)                 # P3
	_fill(23, 12, 4, 1)                 # P4
	_fill(29, 11, 3, 1)                 # ступень к шахте
	_fill(34, 5, 1, 13)                 # столб wall-jump-шахты
	_fill(35, 4, 3, 1)                  # карниз-награда наверху

	_beacon(Vector2(1120, 240))
	_silhouette(Vector2(260, 720), Vector2(620, 460))
	_silhouette(Vector2(1000, 760), Vector2(760, 520))

	_spikes(Vector2(560, 640), 160, 6)  # шипы на полу — перепрыгнуть
	_checkpoint(Vector2(100, 620))      # старт
	_checkpoint(Vector2(1168, 100))     # награда на верху шахты

	_entry("start", Vector2(100, 620))
	_entry("from_east", Vector2(1150, 620))            # приход обратно из room2
	_exit(Rect2(1216, 576, 64, 64), "room2", "from_west")   # дверь справа внизу
