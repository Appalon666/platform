extends Room
## Комната 2 — соседняя справа. Слева внизу дверь → обратно в room1.
## Пока компактная (демо перехода); масштаб нарастим по мере наполнения локации.

func build() -> void:
	size = Vector2i(28, 23)

	_fill(0, 0, 28, 1)                  # потолок
	_fill(0, 20, 28, 3)                 # пол
	_fill(0, 0, 2, 18)                  # левая стена (проём-дверь в рядах 18–19)
	_fill(26, 0, 2, 23)                 # правая стена

	_fill(6, 16, 4, 1)                  # платформы
	_fill(12, 13, 4, 1)
	_fill(18, 15, 4, 1)

	_beacon(Vector2(760, 200))
	_silhouette(Vector2(500, 740), Vector2(700, 500))

	_spikes(Vector2(430, 640), 200, 8)  # шире шипы
	_checkpoint(Vector2(150, 620))

	_entry("from_west", Vector2(150, 620))            # приход из room1
	_exit(Rect2(0, 576, 64, 64), "room1", "from_east")   # дверь слева внизу — назад
